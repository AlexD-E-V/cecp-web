---
/**
 * Botón de WhatsApp con mensaje pre-llenado.
 * Reemplaza las ~15 copias del enlace wa.me del HTML original.
 */
import { waLink, MSG_CITA } from '../config';

interface Props {
  mensaje?: string;
  /** Muestra el icono de WhatsApp a la izquierda */
  icono?: boolean;
  class?: string;
}

const { mensaje = MSG_CITA, icono = true, class: className = '' } = Astro.props;
---

<a class:list={['btn btn-wa', className]} href={waLink(mensaje)} target="_blank" rel="noopener">
  {
    icono && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.7-1.3 1.3-1.8 1.3-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.2.1.4 0 .6l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.7 1.6.3.1.5.1.7-.1l.9-1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.1.1.7-.1 1.7Z" />
      </svg>
    )
  }
  <slot />
</a>
