---
import type { Testimonio as TestimonioData } from '../data/testimonios';

interface Props {
  testimonio: TestimonioData;
  delay: number;
}

const { testimonio: t, delay } = Astro.props;
---

<div class:list={['tst', 'reveal', `d${delay}`]}>
  <div class="tst-head">
    <div class="tst-ava" style={`background:${t.color}`}>{t.inicial}</div>
    <div><b>{t.nombre}</b><span class="stars">★★★★★</span></div>
  </div>
  <p>{t.texto}</p>
  <div class="tst-g">
    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="#4285F4"
        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"
      ></path>
      <path
        fill="#34A853"
        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
      ></path>
      <path
        fill="#FBBC05"
        d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18A10.96 10.96 0 0 0 1 12c0 1.78.43 3.45 1.18 4.94l3.66-2.84z"
      ></path>
      <path
        fill="#EA4335"
        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
      ></path>
    </svg>
    Publicado en Google
  </div>
</div>

<style>
  .tst {
    background: #fff;
    border-radius: var(--radius-tarjeta);
    padding: 26px;
    box-shadow: var(--shadow-suave);
    border: 1px solid rgba(127, 196, 232, 0.25);
    display: flex;
    flex-direction: column;
    transition: transform 0.35s;
  }
  .tst:hover {
    transform: translateY(-6px);
  }
  .tst-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .tst-ava {
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 17px;
  }
  .tst-head b {
    font-family: var(--font-ui);
    font-size: 14.5px;
    display: block;
  }
  .stars {
    color: #fbbc05;
    letter-spacing: 2px;
    font-size: 12px;
  }
  .tst p {
    font-size: 14px;
    color: #3c4657;
    line-height: 1.6;
    flex: 1;
  }
  .tst-g {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--color-gris);
  }
</style>
