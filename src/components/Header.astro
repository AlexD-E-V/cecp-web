---
/**
 * Cabecera fija. El menú se define UNA vez (NAV_LINKS) y alimenta
 * tanto la navegación de escritorio como la móvil — antes estaban duplicados.
 */
import { Image } from 'astro:assets';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { img } from '../assets/img';

const logo = img('logo-cecp');

const NAV_LINKS = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#cardiogenetica', label: 'Cardiogenética' },
  { href: '#especialidades', label: 'Especialidades' },
  { href: '#horario', label: 'Horario' },
  { href: '#testimonios', label: 'Opiniones' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header id="header">
  <div class="container-cecp nav">
    <a href="#inicio" class="brand" aria-label="CECP Inicio">
      <Image class="brand-mark" src={logo} alt="" width={92} format="webp" />
      <span class="brand-txt"><b>CECP</b><small>Centro de Especialidades</small></span>
    </a>
    <nav aria-label="Navegación principal">
      <ul>
        {NAV_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <BotonWhatsApp class="nav-cta">Agendar cita</BotonWhatsApp>
    <button class="burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mmenu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
<div class="mobile-menu" id="mmenu">
  {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
  <a href="#contacto" class="mm-wa">💬 Agendar por WhatsApp</a>
</div>

<script>
  const header = document.getElementById('header')!;
  addEventListener('scroll', () => header.classList.toggle('scrolled', scrollY > 30), {
    passive: true,
  });

  const burger = document.getElementById('burger')!;
  const mmenu = document.getElementById('mmenu')!;
  const setAbierto = (abierto: boolean) => {
    mmenu.classList.toggle('open', abierto);
    burger.classList.toggle('open', abierto);
    burger.setAttribute('aria-expanded', String(abierto));
    burger.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  };
  burger.addEventListener('click', () => setAbierto(!mmenu.classList.contains('open')));
  mmenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setAbierto(false)));
  // cerrar al tocar fuera del menú o al presionar Escape
  document.addEventListener('click', (e) => {
    if (!mmenu.classList.contains('open')) return;
    const objetivo = e.target as Node;
    if (!mmenu.contains(objetivo) && !burger.contains(objetivo)) setAbierto(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setAbierto(false);
  });
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(27, 111, 174, 0.1);
    transition: box-shadow 0.3s;
  }
  header.scrolled {
    box-shadow: 0 6px 24px rgba(14, 58, 93, 0.1);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand-mark {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }
  .brand-txt {
    line-height: 1.1;
  }
  .brand-txt b {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    color: var(--color-azul);
    letter-spacing: 0.03em;
  }
  .brand-txt small {
    display: block;
    font-family: var(--font-ui);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    color: var(--color-gris);
    text-transform: uppercase;
  }
  nav ul {
    display: flex;
    gap: 26px;
    list-style: none;
  }
  nav a {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14.5px;
    color: var(--color-azul-oscuro);
    position: relative;
    padding: 6px 0;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--color-turquesa);
    transition: width 0.3s;
  }
  nav a:hover::after {
    width: 100%;
  }
  header :global(.nav-cta) {
    padding: 10px 20px;
    font-size: 14px;
  }
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .burger span {
    width: 26px;
    height: 3px;
    background: var(--color-azul);
    border-radius: 2px;
    transition:
      transform 0.3s,
      opacity 0.3s;
  }
  /* burger → X cuando el menú está abierto: feedback inmediato al toque */
  .burger.open span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .burger.open span:nth-child(2) {
    opacity: 0;
  }
  .burger.open span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  .mobile-menu {
    position: fixed;
    top: 76px;
    left: 0;
    right: 0;
    background: #fff;
    z-index: 890;
    padding: 22px 6%;
    box-shadow: 0 20px 40px rgba(14, 58, 93, 0.15);
    border-top: 1px solid var(--color-celeste-suave);
    /* cerrado: desplazado y transparente; sin display:none para poder animar */
    opacity: 0;
    transform: translateY(-14px);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
      visibility 0.3s;
  }
  .mobile-menu.open {
    opacity: 1;
    transform: none;
    visibility: visible;
    pointer-events: auto;
  }
  .mobile-menu a {
    display: block;
    padding: 13px 0;
    font-family: var(--font-ui);
    font-weight: 500;
    border-bottom: 1px solid var(--color-gris-claro);
  }
  .mobile-menu .mm-wa {
    color: var(--color-whatsapp);
    font-weight: 600;
  }
  @media (max-width: 980px) {
    nav ul,
    header :global(.nav-cta) {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
</style>
