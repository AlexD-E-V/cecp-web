---
const ITEMS = [
  {
    color: '#1B6FAE',
    svg: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
    titulo: 'Atención familiar',
    texto: 'Cuidamos a cada miembro de tu familia, de bebés a adultos.',
  },
  {
    color: '#19B5A5',
    svg: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
    titulo: 'Especialistas certificados',
    texto: 'Médicos con experiencia en cada área de atención.',
  },
  {
    color: '#1B6FAE',
    svg: '<rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8M12 18v3"/>',
    titulo: 'Tecnología actualizada',
    texto: 'Equipos de primera generación para diagnósticos precisos.',
  },
  {
    color: '#3FAE8C',
    svg: '<path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/>',
    titulo: 'Ubicación estratégica',
    texto: 'Av. Pedro Menéndez Gilbert, cerca de SOLCA y Metrovía.',
  },
];
---

<div class="trust container-cecp">
  <div class="trust-grid reveal">
    {
      ITEMS.map((item) => (
        <div class="trust-item">
          <div class="trust-ico">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke={item.color}
              stroke-width="2"
              aria-hidden="true"
              set:html={item.svg}
            />
          </div>
          <div>
            <b>{item.titulo}</b>
            <span>{item.texto}</span>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .trust {
    padding: 0;
    margin-top: -56px;
    position: relative;
    z-index: 5;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    background: #fff;
    border-radius: 24px;
    padding: 30px;
    box-shadow: 0 24px 60px rgba(14, 58, 93, 0.12);
    border: 1px solid rgba(127, 196, 232, 0.3);
  }
  .trust-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .trust-ico {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-celeste-suave);
  }
  .trust-ico svg {
    width: 24px;
    height: 24px;
  }
  .trust-item b {
    font-family: var(--font-ui);
    font-size: 14.5px;
    display: block;
  }
  .trust-item span {
    font-size: 12.5px;
    color: var(--color-gris);
  }
  @media (max-width: 980px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .trust-grid {
      grid-template-columns: 1fr;
      padding: 22px;
    }
  }
</style>
