---
/**
 * Pantalla de bienvenida (restaurada del diseño original con tres cambios de fondo):
 *
 * 1. Ya no es una espera fabricada de 3 s: se oculta cuando la página termina de
 *    cargar (evento `load`), con una gracia mínima de 800 ms para que la animación
 *    alcance a verse y un tope duro de 4 s por si algún recurso se cuelga.
 * 2. Solo aparece en la primera visita de la sesión (sessionStorage): navegar
 *    entre páginas del sitio no vuelve a mostrarla.
 * 3. Con prefers-reduced-motion no se muestra en absoluto (ni suena la campanada).
 * 4. Campanada de bienvenida (acorde C6-E6-G6 sintetizado): los navegadores
 *    BLOQUEAN todo audio hasta el primer gesto del usuario (política de
 *    autoplay de Chrome/Safari), así que se intenta al armar y, si el contexto
 *    está suspendido, queda a la espera del primer toque/clic/tecla. Ese
 *    "retraso" no es un bug nuestro: ningún sitio puede sonar antes del primer
 *    gesto, y el HTML original tenía exactamente la misma limitación.
 */
---

<noscript>
  <style>
    /* Sin JavaScript nadie puede ocultar el loader: no mostrarlo en absoluto */
    #loader {
      display: none !important;
    }
  </style>
</noscript>
<div id="loader" role="status" aria-label="Cargando CECP">
  <div class="loader-3d">
    <div class="loader-logo">CECP</div>
  </div>
  <svg class="loader-wave" viewBox="0 0 360 34" aria-hidden="true">
    <path d="M4 20 Q 50 2, 95 18 T 185 16 T 275 18 T 356 14"></path>
    <path class="w2" d="M4 27 Q 55 12, 100 25 T 190 23 T 280 25 T 356 21"></path>
  </svg>
  <div class="loader-sub">Centro de Especialidades</div>
  <div class="loader-bienvenida">Bienvenido, tu salud es nuestra prioridad</div>
  <div class="loader-bar"><span></span></div>
</div>

<script is:inline>
  (function () {
    var GRACIA = 1200; // ms mínimos VISIBLES para que la animación se aprecie
    var TOPE = 4000; // nunca bloquear más que esto, pase lo que pase

    var loader = document.getElementById('loader');
    if (!loader) return;
    var visto = false;
    try {
      visto = sessionStorage.getItem('cecp-loader') === '1';
    } catch (e) {}
    if (visto || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      loader.remove();
      return;
    }

    document.documentElement.style.overflow = 'hidden';
    var oculto = false;

    function ocultar() {
      if (oculto) return;
      oculto = true;
      loader.classList.add('hide');
      document.documentElement.style.overflow = '';
      setTimeout(function () {
        loader.remove(); // fuera del DOM: nunca vuelve a interceptar clics
      }, 900);
    }

    // Campanada de bienvenida (acorde C6-E6-G6). Los navegadores bloquean el
    // audio hasta el PRIMER GESTO del usuario (política de autoplay): se intenta
    // al armar y, si el contexto nace suspendido, se reintenta al primer
    // toque/clic/tecla. Suena una sola vez, y solo en la visita del loader.
    var sono = false;
    var GESTOS = ['pointerdown', 'touchstart', 'keydown'];
    function campanada() {
      if (sono) return;
      try {
        // El cast en comentario es para el verificador de tipos: Safari antiguo
        // solo expone webkitAudioContext, que no está en la definición de Window.
        // Al ser un script is:inline se emite tal cual, así que tiene que ser
        // JavaScript válido — de ahí el JSDoc y no una anotación de TypeScript.
        var AC = window.AudioContext || /** @type {any} */ (window).webkitAudioContext;
        var actx = new AC();
        if (actx.state === 'suspended') {
          actx.close();
          return; // sin gesto todavía: el listener volverá a intentar
        }
        sono = true;
        GESTOS.forEach(function (ev) {
          document.removeEventListener(ev, campanada, true);
        });
        [[523.25, 0], [659.25, 0.16], [783.99, 0.32]].forEach(function (nota) {
          var o = actx.createOscillator();
          var g = actx.createGain();
          o.type = 'sine';
          o.frequency.value = nota[0];
          g.gain.setValueAtTime(0, actx.currentTime + nota[1]);
          g.gain.linearRampToValueAtTime(0.42, actx.currentTime + nota[1] + 0.06);
          g.gain.exponentialRampToValueAtTime(0.001, actx.currentTime + nota[1] + 1.4);
          o.connect(g).connect(actx.destination);
          o.start(actx.currentTime + nota[1]);
          o.stop(actx.currentTime + nota[1] + 1.5);
        });
      } catch (e) {}
    }

    // Los relojes y las animaciones arrancan recién cuando la página es VISIBLE.
    // Chrome pre-renderiza páginas en segundo plano (sobre todo al escribir la URL);
    // si el cronómetro corriera durante esa fase invisible, el loader se consumiría
    // antes de que el visitante vea nada.
    function armar() {
      try {
        sessionStorage.setItem('cecp-loader', '1');
      } catch (e) {}
      loader.classList.add('go'); // dispara las animaciones CSS desde cero
      var inicio = Date.now();
      var alCargar = function () {
        setTimeout(ocultar, Math.max(0, GRACIA - (Date.now() - inicio)));
      };
      if (document.readyState === 'complete') alCargar();
      else addEventListener('load', alCargar);
      setTimeout(ocultar, TOPE);
      // intento inmediato de la campanada + a la espera del primer gesto
      setTimeout(campanada, 200);
      GESTOS.forEach(function (ev) {
        document.addEventListener(ev, campanada, { capture: true });
      });
    }

    if (document.prerendering) {
      document.addEventListener('prerenderingchange', armar, { once: true });
    } else if (document.hidden) {
      document.addEventListener('visibilitychange', function alMostrar() {
        if (!document.hidden) {
          document.removeEventListener('visibilitychange', alMostrar);
          armar();
        }
      });
    } else {
      armar();
    }
  })();
</script>

<style>
  #loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    background: radial-gradient(
      1200px 600px at 50% 30%,
      #155a8e 0%,
      var(--color-azul-oscuro) 55%,
      #081f33 100%
    );
    transition:
      opacity 0.8s ease,
      visibility 0.8s;
    perspective: 900px;
  }
  #loader.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: -1;
  }
  /* Estados iniciales estáticos: las animaciones se disparan con la clase .go,
     que el script agrega recién cuando la página es visible */
  .loader-3d {
    transform-style: preserve-3d;
    opacity: 0;
  }
  #loader.go .loader-3d {
    animation: spin3d 1.2s cubic-bezier(0.45, 0.05, 0.35, 1) forwards;
  }
  .loader-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(64px, 14vw, 120px);
    letter-spacing: 0.04em;
    color: #fff;
    text-shadow:
      1px 1px 0 #6db6e6,
      2px 2px 0 #5fa8dc,
      3px 3px 0 #519ad2,
      4px 4px 0 #438cc8,
      5px 5px 0 #357ebe,
      6px 6px 0 #2770b4,
      7px 7px 0 #1962a0,
      8px 8px 0 #0b548c,
      10px 12px 30px rgba(0, 0, 0, 0.45);
  }
  @keyframes spin3d {
    0% {
      transform: rotateY(-95deg) rotateX(12deg) scale(0.7);
      opacity: 0;
    }
    35% {
      transform: rotateY(18deg) rotateX(-6deg) scale(1.05);
      opacity: 1;
    }
    60% {
      transform: rotateY(-10deg) rotateX(4deg) scale(1);
      opacity: 1;
    }
    /* opacity explícita hasta el final: el estado base es opacity:0 (gating con
       .go) y un fotograma sin opacity interpolaría de vuelta hacia ese 0 */
    100% {
      transform: rotateY(0) rotateX(0) scale(1);
      opacity: 1;
    }
  }
  .loader-wave {
    width: min(360px, 70vw);
    height: 34px;
    overflow: visible;
  }
  .loader-wave path {
    fill: none;
    stroke: var(--color-celeste);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
  }
  #loader.go .loader-wave path {
    animation: draw 1.1s 0.15s ease forwards;
  }
  .loader-wave .w2 {
    stroke: var(--color-turquesa);
    stroke-width: 3;
    opacity: 0.85;
  }
  #loader.go .loader-wave .w2 {
    animation-delay: 0.35s;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .loader-sub {
    color: var(--color-celeste);
    font-family: var(--font-ui);
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-size: 13px;
    opacity: 0;
  }
  #loader.go .loader-sub {
    animation: fadeUp 0.7s 0.45s forwards;
  }
  .loader-bienvenida {
    /* serif itálica del sistema: la webfont del original (Playfair Display)
       no alcanzaba a descargarse en el tiempo de vida del loader */
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    color: #fff;
    font-size: clamp(18px, 3vw, 24px);
    opacity: 0;
  }
  #loader.go .loader-bienvenida {
    animation: fadeUp 0.7s 0.65s forwards;
  }
  .loader-bar {
    width: min(260px, 60vw);
    height: 3px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    overflow: hidden;
  }
  .loader-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--color-celeste), var(--color-turquesa));
  }
  #loader.go .loader-bar span {
    animation: fill 0.9s ease-out forwards;
  }
  @keyframes fill {
    to {
      width: 100%;
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
