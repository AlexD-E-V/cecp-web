---
import { getImage } from 'astro:assets';
import Globo from './islas/Globo.tsx';
import { COORDENADAS, DIRECCION_CORTA, MAPS_URL } from '../config';
import { img } from '../assets/img';

const croquis = img('croquis-ubicacion');

const croquisOpt = await getImage({ src: croquis, width: croquis.width, format: 'webp' });

const REFS = [
  { color: '#1B6FAE', nombre: 'Estación de la Metrovía' },
  { color: '#19B5A5', nombre: 'SOLCA' },
  { color: '#3FAE8C', nombre: 'Fundación Renal del Ecuador' },
  { color: '#E8843C', nombre: 'ITB Instituto Superior' },
  { color: '#7A5FD0', nombre: 'Autolasa Atarazana' },
  { color: '#E86FA4', nombre: 'Parqueo disponible' },
];
---

<section class="mapa-footer">
  <div class="mf-head reveal">
    <svg class="pin-gps" viewBox="0 0 24 24" fill="#1B6FAE" aria-hidden="true">
      <path
        d="M12 2a8 8 0 0 0-8 8c0 5.4 7 11.5 7.3 11.8a1 1 0 0 0 1.4 0C13 21.5 20 15.4 20 10a8 8 0 0 0-8-8Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
      ></path>
    </svg>
    <span class="tag">Encuéntranos</span>
    <h2>Así de fácil es llegar a CECP</h2>
    <p>
      Av. Pedro Menéndez Gilbert, Atarazana — pasando la estación de la Metrovía, cerca de SOLCA.
      Parqueo disponible.
    </p>
  </div>
  <div class="globo-zona">
    <div class="reveal">
      <Globo
        client:visible
        lat={COORDENADAS.lat}
        lon={COORDENADAS.lon}
        fallbackSrc={croquisOpt.src}
        fallbackAlt={`Croquis de ubicación de CECP: ${DIRECCION_CORTA}, entre la estación de la Metrovía, Fundación Renal del Ecuador y SOLCA`}
      />
    </div>
    <div class="globo-info reveal d2">
      <h3>CECP para todo el Ecuador y el mundo</h3>
      <p>
        Gira el globo y encuéntranos: estamos en la Av. Pedro Menéndez Gilbert, en una ubicación
        estratégica rodeada de puntos de referencia que hacen muy fácil llegar.
      </p>
      <div class="refs">
        {
          REFS.map((r) => (
            <span class="ref-chip">
              <span class="rc" style={`background:${r.color}`} />
              {r.nombre}
            </span>
          ))
        }
      </div>
      <a class="btn btn-azul" href={MAPS_URL} target="_blank" rel="noopener"
        >📍 Abrir ubicación en Google Maps</a
      >
    </div>
  </div>
</section>

<style>
  .mapa-footer {
    padding: 0;
    margin-top: 96px;
  }
  .mf-head {
    text-align: center;
    background: #fff;
    position: relative;
    z-index: 2;
    /* margen lateral: en el original el texto tocaba los bordes del celular */
    padding: 0 6% 34px;
  }
  .mf-head h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 800;
  }
  .mf-head p {
    color: var(--color-gris);
    margin-top: 12px;
    max-width: 560px;
    margin-inline: auto;
  }
  .pin-gps {
    width: 58px;
    height: 58px;
    display: block;
    margin: 0 auto 10px;
    animation: float 4s ease-in-out infinite;
    filter: drop-shadow(0 14px 22px rgba(27, 111, 174, 0.35));
  }
  .globo-zona {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
    width: min(1080px, 92%);
    margin: 0 auto;
    padding: 10px 0 60px;
  }
  .globo-info h3 {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 800;
    margin-bottom: 14px;
  }
  .globo-info p {
    color: var(--color-gris);
    font-size: 15px;
    margin-bottom: 20px;
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 26px;
  }
  .ref-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid rgba(127, 196, 232, 0.4);
    border-radius: 50px;
    padding: 9px 16px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    box-shadow: 0 6px 16px rgba(14, 58, 93, 0.08);
  }
  .ref-chip .rc {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
  }
  @media (max-width: 980px) {
    .globo-zona {
      grid-template-columns: 1fr;
      gap: 26px;
      text-align: center;
    }
    .refs {
      justify-content: center;
    }
  }
</style>
