---
/**
 * Membresía Familiar CECP: plan mensual que cubre a toda la familia.
 * El precio y el porcentaje de descuento viven en config.ts (fuente única,
 * también consumida por el JSON-LD de la oferta en la portada).
 */
import { Image } from 'astro:assets';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { img } from '../assets/img';
import { MEMBRESIA } from '../config';

const familia = img('membresia-familia');
const tarjeta = img('membresia-tarjeta');

const BENEFICIOS = [
  {
    svg: '<path d="M6 3v6a6 6 0 0 0 12 0V3"/><path d="M4 3h4M16 3h4"/><path d="M12 15v2a4 4 0 0 0 8 0v-1"/><circle cx="20" cy="14" r="2"/>',
    titulo: 'Consultas con especialistas',
    texto: 'Cardiología, pediatría, ginecología, odontología y más.',
  },
  {
    svg: '<path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1Z"/><path d="M3 12.5h4l1.5-3 2.5 6 2-3h6"/>',
    titulo: 'Procedimientos cardiovasculares',
    texto: 'ECG, ecocardiograma y Holter con tecnología de última generación.',
  },
  {
    svg: '<path d="M9 3h6M10 3v6.5L4.8 18a2 2 0 0 0 1.7 3h11a2 2 0 0 0 1.7-3L14 9.5V3"/><path d="M7.5 15h9"/>',
    titulo: 'Exámenes de laboratorio',
    texto: 'Resultados confiables para un diagnóstico oportuno.',
  },
  {
    svg: '<rect x="2" y="5" width="20" height="14" rx="3"/><circle cx="12" cy="12" r="3.5"/><path d="M6 9h.01M6 15h.01"/>',
    titulo: 'Estudios de imagen',
    texto: 'Apoyo diagnóstico por imagen cuando tu médico lo requiera.',
  },
];
---

<section class="memb seccion" id="membresia">
  <Image
    class="memb-bg"
    src={familia}
    alt=""
    aria-hidden="true"
    width={1500}
    format="webp"
    loading="lazy"
  />
  <span class="memb-velo" aria-hidden="true"></span>
  <div class="container-cecp memb-grid">
    <div class="reveal">
      <span class="memb-tag">♥ MEMBRESÍA FAMILIAR CECP</span>
      <h2>Protege lo que <span class="hl">más amas</span></h2>
      <p class="memb-intro">
        Una sola membresía mensual que cuida a toda tu familia: acceso preferente a nuestras
        especialidades, procedimientos y exámenes, con la experiencia, la eficiencia y la atención
        oportuna que nos caracterizan.
      </p>
      <ul class="memb-list">
        {
          BENEFICIOS.map((b) => (
            <li>
              <span class="memb-ico">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#5FE0D0"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={b.svg}
                />
              </span>
              <span>
                <b>{b.titulo}</b>
                <small>{b.texto}</small>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="memb-desc">
        <b>Hasta {MEMBRESIA.descuento}% de descuento</b> en todas nuestras especialidades, para cada
        miembro de la familia.
      </p>
      <BotonWhatsApp mensaje={MEMBRESIA.mensajeWhatsApp} icono={false}>
        Quiero la Membresía Familiar
      </BotonWhatsApp>
    </div>

    <div class="memb-visual reveal d2">
      <div class="memb-tarjeta-wrap">
        <Image
          class="memb-tarjeta"
          src={tarjeta}
          alt="Tarjeta de la Membresía Familiar CECP con código QR y datos del titular, válida para toda la familia"
          width={720}
          format="webp"
          loading="lazy"
        />
        <span class="memb-precio">
          <b>${MEMBRESIA.precio}</b>
          al mes
        </span>
      </div>
      <p class="memb-lema">“Cuidamos a la familia”</p>
      <p class="memb-sub">Experiencia, eficiencia y atención oportuna.</p>
    </div>
  </div>
</section>

<style>
  .memb {
    color: #fff;
    overflow: hidden;
    background: linear-gradient(150deg, #0b2d4b 0%, #0e3a5d 55%, #124b7a 100%);
  }
  .memb :global(.memb-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    z-index: 0;
    opacity: 0.34;
  }
  .memb-velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(680px 380px at 12% 18%, rgba(25, 181, 165, 0.16), transparent 64%),
      linear-gradient(100deg, rgba(11, 45, 75, 0.96) 0%, rgba(14, 58, 93, 0.86) 46%, rgba(18, 75, 122, 0.62) 100%);
  }
  .memb-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 54px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .memb-tag {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: rgba(25, 181, 165, 0.18);
    border: 1px solid rgba(25, 181, 165, 0.4);
    border-radius: 50px;
    padding: 8px 18px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #5fe0d0;
    margin-bottom: 20px;
  }
  .memb-grid h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 800;
    line-height: 1.18;
    margin-bottom: 18px;
  }
  .memb-grid h2 .hl {
    color: #5fe0d0;
  }
  .memb-intro {
    color: rgba(255, 255, 255, 0.82);
    font-size: 16px;
  }
  .memb-list {
    list-style: none;
    margin: 26px 0 24px;
    display: grid;
    gap: 16px;
    padding: 0;
  }
  .memb-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .memb-ico {
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(95, 224, 208, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .memb-ico svg {
    width: 21px;
    height: 21px;
  }
  .memb-list b {
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    display: block;
  }
  .memb-list small {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.55;
  }
  .memb-desc {
    background: rgba(25, 181, 165, 0.14);
    border: 1px solid rgba(25, 181, 165, 0.34);
    border-radius: 14px;
    padding: 14px 18px;
    font-size: 14.5px;
    margin-bottom: 26px;
  }
  .memb-desc b {
    color: #5fe0d0;
  }

  .memb-visual {
    text-align: center;
  }
  .memb-tarjeta-wrap {
    position: relative;
    width: min(430px, 100%);
    margin: 0 auto;
    padding-bottom: 26px;
  }
  .memb-visual :global(.memb-tarjeta) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.42);
    transform: rotate(-3deg);
  }
  .memb-precio {
    position: absolute;
    right: -10px;
    bottom: 0;
    z-index: 3;
    background: linear-gradient(120deg, #5fe0d0, #7fc4e8);
    color: #0b3556;
    border-radius: 18px;
    padding: 12px 20px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1.2;
    text-align: center;
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.38);
  }
  .memb-precio b {
    font-family: var(--font-display);
    font-size: 30px;
    display: block;
  }
  .memb-lema {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    margin-top: 34px;
  }
  .memb-sub {
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 4px;
  }

  @media (max-width: 980px) {
    .memb-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      text-align: center;
    }
    .memb-tag {
      margin-inline: auto;
    }
    .memb-list {
      text-align: left;
      max-width: 460px;
      margin-inline: auto;
    }
    .memb-desc {
      max-width: 460px;
      margin-inline: auto;
      margin-bottom: 26px;
    }
  }
  @media (max-width: 560px) {
    /* la insignia de precio no debe sobresalir del margen del contenedor */
    .memb-precio {
      right: 0;
      padding: 10px 16px;
    }
    .memb-precio b {
      font-size: 26px;
    }
  }
</style>
