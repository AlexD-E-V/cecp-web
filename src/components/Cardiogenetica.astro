---
import { Image } from 'astro:assets';
import BotonWhatsApp from './BotonWhatsApp.astro';
import Particulas from './islas/Particulas.tsx';
import { img } from '../assets/img';

const electro = img('cardiogen-electrocardiografo');
const monitoreo = img('cardiogen-monitoreo');

const BENEFICIOS = [
  '<b>Amiloidosis Cardíaca:</b> abordaje especializado de una condición frecuentemente subdiagnosticada.',
  '<b>Inteligencia artificial diagnóstica:</b> tecnología cardiovascular de última generación con IA de precisión.',
  '<b>Detección temprana de riesgo hereditario</b> para ti y tu familia.',
];
---

<section class="cardiogen seccion" id="cardiogenetica">
  <Particulas
    client:visible
    nPC={44}
    nMovil={26}
    rMin={1.8}
    rMax={4.6}
    oMin={0.22}
    oMax={0.52}
    colPunto="#7FC4E8"
    colCruz="#5FE0D0"
    plx={58}
  />
  <svg
    class="cg-helix"
    viewBox="0 0 100 300"
    fill="none"
    stroke="#5FE0D0"
    stroke-width="3"
    aria-hidden="true"
  >
    <path
      d="M25 0 C 75 37, 75 67, 25 105 C 75 142, 75 172, 25 210 C 75 247, 75 277, 25 300"></path>
    <path
      d="M75 0 C 25 37, 25 67, 75 105 C 25 142, 25 172, 75 210 C 25 247, 25 277, 75 300"></path>
    <path
      d="M32 18 H68 M30 40 H70 M32 78 H68 M30 105 H70 M32 145 H68 M30 172 H70 M32 210 H68 M30 245 H70 M32 282 H68"
    ></path>
  </svg>
  <div class="container-cecp cg-grid">
    <div class="reveal">
      <span class="cg-badge">★ PRIMEROS EN GUAYAQUIL</span>
      <h2>
        Pioneros en <span class="hl">Cardiogenética</span> y <span class="hl"
          >Amiloidosis Cardíaca</span
        >
      </h2>
      <p>
        Somos el primer centro médico de Guayaquil especializado en Cardiogenética, una disciplina
        que estudia el origen genético de las enfermedades del corazón para diagnosticar antes, con
        mayor precisión y de forma personalizada.
      </p>
      <ul class="cg-list">
        {
          BENEFICIOS.map((b) => (
            <li>
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#5FE0D0"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span set:html={b} />
            </li>
          ))
        }
      </ul>
      <BotonWhatsApp
        mensaje="Hola CECP, quiero información sobre cardiogenética y amiloidosis cardíaca."
        icono={false}
      >
        Consultar sobre Cardiogenética
      </BotonWhatsApp>
    </div>
    <div class="cg-visual reveal d2">
      <div class="cg-collage">
        <span class="cgc-badge"><b>1º</b>Centro de Cardiogenética<br />de Guayaquil</span>
        <Image
          class="cgc-a"
          src={electro}
          alt="Especialista de CECP registrando datos en el electrocardiógrafo con pantalla táctil e inteligencia artificial"
          width={640}
          format="webp"
          loading="lazy"
        />
        <Image
          class="cgc-b"
          src={monitoreo}
          alt="Monitoreo de signos vitales a un paciente en el consultorio de cardiología de CECP"
          width={520}
          format="webp"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .cardiogen {
    color: #fff;
    overflow: hidden;
    background:
      radial-gradient(620px 320px at 86% 12%, rgba(95, 224, 208, 0.09), transparent 62%),
      radial-gradient(540px 340px at 8% 88%, rgba(127, 196, 232, 0.11), transparent 62%),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.026) 0 1px, transparent 1px 48px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.026) 0 1px, transparent 1px 48px),
      linear-gradient(150deg, #0b2d4b 0%, #0e3a5d 55%, #124b7a 100%);
  }
  .cg-helix {
    position: absolute;
    right: -40px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.1;
    width: 340px;
    pointer-events: none;
    z-index: 1;
  }
  .cg-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 50px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .cg-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: rgba(25, 181, 165, 0.18);
    border: 1px solid rgba(25, 181, 165, 0.4);
    border-radius: 50px;
    padding: 8px 18px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #5fe0d0;
    margin-bottom: 20px;
  }
  .cg-grid h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 800;
    line-height: 1.18;
    margin-bottom: 18px;
  }
  .cg-grid h2 .hl {
    color: #5fe0d0;
  }
  .cg-grid p {
    color: rgba(255, 255, 255, 0.82);
    font-size: 16px;
    margin-bottom: 16px;
  }
  .cg-list {
    list-style: none;
    margin: 22px 0 30px;
    display: grid;
    gap: 14px;
    padding: 0;
  }
  .cg-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
  }
  .cg-list svg {
    flex: none;
    margin-top: 2px;
  }
  .cg-visual {
    display: flex;
    justify-content: center;
  }
  .cg-collage {
    position: relative;
    width: min(460px, 100%);
    padding-bottom: 44px;
  }
  .cg-collage :global(.cgc-a) {
    width: 82%;
    height: auto;
    border-radius: 20px;
    display: block;
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  .cg-collage :global(.cgc-b) {
    position: absolute;
    width: 56%;
    height: auto;
    right: 0;
    bottom: 0;
    border-radius: 16px;
    border: 5px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.4);
    display: block;
  }
  .cgc-badge {
    position: absolute;
    top: -18px;
    right: 2%;
    z-index: 3;
    background: linear-gradient(120deg, #5fe0d0, #7fc4e8);
    color: #0b3556;
    border-radius: 16px;
    padding: 12px 18px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1.35;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
    text-align: center;
  }
  .cgc-badge b {
    font-family: var(--font-display);
    font-size: 22px;
    display: block;
  }
  @media (max-width: 980px) {
    .cg-grid {
      grid-template-columns: 1fr;
      gap: 34px;
      text-align: center;
    }
    .cg-list {
      text-align: left;
    }
    .cg-badge {
      margin-inline: auto;
    }
  }
</style>
