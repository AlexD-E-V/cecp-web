---
/**
 * Aviso de cookies + Google Consent Mode v2.
 *
 * La analítica (Google Analytics) arranca DENEGADA por defecto (ver Base.astro).
 * Este banner solo aparece si el visitante aún no ha decidido, y al pulsar:
 *   - "Aceptar"  → concede analytics_storage (GA empieza a medir).
 *   - "Rechazar" → deniega analytics_storage (GA queda en modo sin cookies).
 * La decisión se guarda en localStorage para no volver a preguntar.
 *
 * REVOCACIÓN: la LOPDP exige que retirar el consentimiento sea tan fácil como
 * darlo. Cualquier elemento con el atributo `data-cecp-cookies` (hoy: el enlace
 * del pie de página y el de la política de privacidad) vuelve a abrir este
 * aviso para cambiar la decisión. Al rechazar tras haber aceptado no basta con
 * denegar el consentimiento: también se borran las cookies `_ga*` que Google ya
 * hubiera escrito, para que la retirada sea efectiva y no solo declarativa.
 *
 * No usa publicidad: ad_storage se mantiene siempre denegado.
 */
---

<div id="cecp-cookies" class="cookies" role="region" aria-label="Preferencias de cookies" hidden>
  <p class="cookies__txt">
    Usamos cookies de analítica para entender cómo se usa el sitio y mejorarlo. No usamos cookies
    publicitarias. Puedes aceptarlas o rechazarlas; el sitio funciona igual.
    <a href="/privacidad/">Más información</a>.
  </p>
  <p class="cookies__estado" id="cecp-cookies-estado" hidden></p>
  <div class="cookies__acc">
    <button type="button" id="cecp-cookies-reject" class="btn btn--ghost">Rechazar</button>
    <button type="button" id="cecp-cookies-accept" class="btn btn--solid">Aceptar</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'cecp-consent';
    var banner = document.getElementById('cecp-cookies');
    if (!banner) return;

    var estado = document.getElementById('cecp-cookies-estado');
    var btnAceptar = document.getElementById('cecp-cookies-accept');
    var btnRechazar = document.getElementById('cecp-cookies-reject');

    function leer() {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        return null;
      }
    }

    /** Comunica la decisión a Google Consent Mode (si GA llegó a cargar). */
    function aplicar(valor) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('consent', 'update', {
        analytics_storage: valor === 'accepted' ? 'granted' : 'denied',
      });
    }

    /**
     * Borra las cookies que Google Analytics ya hubiera escrito (_ga, _ga_XXXX,
     * _gid). Consent Mode deja de usarlas, pero permanecen en el navegador
     * hasta su vencimiento: al revocar hay que retirarlas de verdad.
     * Se prueba con el host exacto y con el dominio raíz, porque GA las escribe
     * sobre el dominio de nivel superior (.cecponline.com).
     */
    function borrarCookiesGA() {
      var host = location.hostname;
      var dominios = ['', host, '.' + host];
      var partes = host.split('.');
      if (partes.length > 2) {
        var raiz = partes.slice(-2).join('.');
        dominios.push(raiz, '.' + raiz);
      }
      document.cookie.split(';').forEach(function (trozo) {
        var nombre = trozo.split('=')[0].trim();
        if (nombre.indexOf('_ga') !== 0 && nombre.indexOf('_gid') !== 0) return;
        dominios.forEach(function (d) {
          document.cookie =
            nombre + '=; max-age=0; path=/' + (d ? '; domain=' + d : '');
        });
      });
    }

    /** @param {boolean} manual - true si lo abrió el visitante desde un enlace. */
    function mostrar(manual) {
      var previo = leer();
      if (estado) {
        if (manual && previo) {
          estado.textContent =
            previo === 'accepted'
              ? 'Ahora mismo aceptas las cookies de analítica.'
              : 'Ahora mismo las cookies de analítica están rechazadas.';
          estado.hidden = false;
        } else {
          estado.hidden = true;
        }
      }
      banner.hidden = false;
      // Al abrirlo a propósito se lleva el foco al aviso; en la primera visita
      // NO se toca el foco (robárselo al cargar la página es intrusivo).
      if (manual && btnAceptar) btnAceptar.focus();
    }

    function decidir(valor) {
      try {
        localStorage.setItem(KEY, valor);
      } catch (e) {}
      aplicar(valor);
      if (valor === 'rejected') borrarCookiesGA();
      banner.hidden = true;
    }

    if (btnAceptar) {
      btnAceptar.addEventListener('click', function () {
        decidir('accepted');
      });
    }
    if (btnRechazar) {
      btnRechazar.addEventListener('click', function () {
        decidir('rejected');
      });
    }

    // Reapertura: cualquier elemento con data-cecp-cookies (pie de página,
    // política de privacidad) vuelve a abrir el aviso para cambiar la decisión.
    document.addEventListener('click', function (e) {
      var disparador = e.target.closest && e.target.closest('[data-cecp-cookies]');
      if (!disparador) return;
      e.preventDefault();
      mostrar(true);
    });

    // Primera visita (aún sin decisión): se muestra solo.
    var previo = leer();
    if (previo !== 'accepted' && previo !== 'rejected') mostrar(false);
  })();
</script>

<style>
  .cookies {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    max-width: 560px;
    margin-inline: auto;
    background: #fff;
    border: 1px solid var(--color-celeste-suave);
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(14, 58, 93, 0.18);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cookies[hidden] {
    display: none;
  }
  .cookies__txt {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-gris);
  }
  .cookies__txt a {
    color: var(--color-azul);
    text-decoration: underline;
  }
  .cookies__estado {
    margin: -4px 0 0;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-azul);
  }
  .cookies__estado[hidden] {
    display: none;
  }
  .cookies__acc {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }
  .btn {
    font-family: var(--font-ui, inherit);
    font-size: 13.5px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 10px;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.15s;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn--solid {
    background: var(--color-azul);
    color: #fff;
  }
  .btn--solid:hover {
    background: var(--color-azul-oscuro);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-gris);
    border-color: var(--color-celeste-suave);
  }
  .btn--ghost:hover {
    border-color: var(--color-celeste);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
    .btn:hover {
      transform: none;
    }
  }
</style>
