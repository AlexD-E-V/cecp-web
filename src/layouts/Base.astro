---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import { GA_ID, MSG_CITA, waLink, NOMBRE } from '../config';

interface Props {
  title: string;
  description: string;
  /** true mientras el sitio viva en la URL provisional y no deba indexarse una página */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// Canonical correcto: apunta a la URL real donde vive el sitio (astro.config `site`),
// no a un dominio inexistente. Cuando llegue el dominio real solo cambia `site`.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-cecp.jpg', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="author" content="CECP Centro de Especialidades" />
    <meta name="geo.region" content="EC-G" />
    <meta name="geo.placename" content="Guayaquil, Atarazana" />

    {/* Tipografías servidas desde este mismo dominio (ver `fonts` en
        astro.config.ts). Ya no hay preconnect a Google: no queda ninguna
        petición a servidores ajenos para pintar el texto.

        `preload` solo en Montserrat e Inter: son variables (un archivo cada
        una) y cubren titulares y cuerpo de texto. Poppins queda fuera porque
        son 3 archivos estáticos, y precargarlos competiría con la imagen del
        hero —que es lo que marca el LCP— para ganar milisegundos en botones y
        menú. Astro genera tipografías de reserva con métricas ajustadas, así
        que el cambio apenas mueve el diseño. */}
    <Font cssVariable="--fuente-montserrat" preload />
    <Font cssVariable="--fuente-inter" preload />
    <Font cssVariable="--fuente-poppins" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#1B6FAE" />

    <!-- Open Graph (WhatsApp, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOMBRE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />

    {
      GA_ID && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script
            is:inline
            define:vars={{ GA_ID }}
          >
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            // Astro envuelve este script (define:vars) en una función, así que
            // exponemos gtag en window para que el banner de cookies y el rastreo
            // de leads del <body> puedan usarlo.
            window.gtag = gtag;
            gtag('js', new Date());

            // Consent Mode v2: por defecto TODO denegado hasta que el usuario
            // acepte en el aviso de cookies. La clínica no usa publicidad, así
            // que ad_* se queda denegado siempre.
            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
            });

            // Si el visitante ya aceptó en una visita anterior, concedemos analítica.
            try {
              if (localStorage.getItem('cecp-consent') === 'accepted') {
                gtag('consent', 'update', { analytics_storage: 'granted' });
              }
            } catch (e) {}

            gtag('config', GA_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    <Header />
    <slot />
    <Footer />

    <!-- WhatsApp flotante -->
    <a
      class="wa-float"
      href={waLink(MSG_CITA)}
      target="_blank"
      rel="noopener"
      aria-label="WhatsApp CECP"
    >
      <svg viewBox="0 0 24 24"
        ><path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.7-1.3 1.3-1.8 1.3-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.2.1.4 0 .6l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.7 1.6.3.1.5.1.7-.1l.9-1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.1.1.7-.1 1.7Z"
        /></svg
      >
    </a>

    {GA_ID && <AvisoCookies />}

    <script>
      // Reveal al hacer scroll (respeta prefers-reduced-motion vía CSS)
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('on');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.14 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Rastreo de conversiones (solo actúa si GA está configurado en src/config.ts)
      type GtagFn = (...args: unknown[]) => void;
      const gtagFn = (window as unknown as { gtag?: GtagFn }).gtag;
      if (typeof gtagFn === 'function') {
        const track = (tipo: string, origen: string) =>
          gtagFn('event', 'generar_lead', {
            event_category: 'contacto',
            event_label: `${tipo} - ${origen}`,
          });
        document.querySelectorAll<HTMLAnchorElement>('a[href*="wa.me"]').forEach((a) =>
          a.addEventListener('click', () =>
            track('WhatsApp', a.closest('section')?.id || 'general')
          )
        );
        document.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((a) =>
          a.addEventListener('click', () => track('Llamada', a.closest('section')?.id || 'general'))
        );
      }
    </script>
  </body>
</html>
