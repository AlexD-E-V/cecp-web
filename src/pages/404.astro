---
import Base from '../layouts/Base.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
---

<Base
  title="Página no encontrada | CECP Centro de Especialidades"
  description="La página que buscas no existe. Vuelve al inicio del sitio de CECP, Centro de Especialidades Médicas en Guayaquil."
  noindex
>
  <main id="contenido" class="nf container-cecp">
    <p class="nf-code">404</p>
    <h1>Esta página no existe</h1>
    <p class="nf-txt">
      El enlace que seguiste puede estar roto o la página fue movida. Te esperamos en el inicio.
    </p>
    <div class="nf-ctas">
      <a class="btn btn-azul" href="/">Volver al inicio</a>
      <BotonWhatsApp>Agendar una cita</BotonWhatsApp>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 130px 0 90px;
  }
  .nf-code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(64px, 14vw, 120px);
    color: var(--color-celeste);
    line-height: 1;
  }
  .nf h1 {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    margin: 10px 0;
  }
  .nf-txt {
    color: var(--color-gris);
    max-width: 420px;
  }
  .nf-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 28px;
  }
</style>
