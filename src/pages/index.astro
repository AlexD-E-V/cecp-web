---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Hero from '../components/Hero.astro';
import Confianza from '../components/Confianza.astro';
import Cardiogenetica from '../components/Cardiogenetica.astro';
import Especialidades from '../components/Especialidades.astro';
import Membresia from '../components/Membresia.astro';
import Horario from '../components/Horario.astro';
import Testimonios from '../components/Testimonios.astro';
import Contacto from '../components/Contacto.astro';
import MapaUbicacion from '../components/MapaUbicacion.astro';
import { especialidades } from '../data/especialidades';
import {
  COORDENADAS,
  DIRECCION,
  EMAIL,
  HORARIO,
  MAPS_SHARE,
  MEMBRESIA,
  NOMBRE_LEGAL,
  REDES,
  TELEFONO,
} from '../config';

const TITLE =
  'CECP - Centro de Especialidades Médicas en Guayaquil | Cardiología, Pediatría, Odontología';
const DESCRIPTION =
  'CECP: atención médica especializada para toda la familia en Guayaquil. Cardiología, pediatría, neonatología, ginecología, odontología y más. Equipos de primera generación y Membresía Familiar desde $50 al mes. Agenda por WhatsApp en segundos.';

const siteUrl = Astro.site!.toString();

// Schema.org: MedicalClinic (sin aggregateRating: Google ignora las valoraciones
// autodeclaradas en el propio sitio; las reseñas reales viven en Google Maps)
const schemaClinica = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  '@id': `${siteUrl}#clinic`,
  name: NOMBRE_LEGAL,
  alternateName: 'Cecp Especialidades Médicas',
  description:
    'Primer centro médico de Guayaquil especializado en Cardiogenética, pionero en el abordaje de la Amiloidosis Cardíaca. Atención integral en pediatría y múltiples especialidades con tecnología cardiovascular respaldada por inteligencia artificial. Consultorio de lunes a viernes de 7:00 a 16:00, y atención con cita previa los 7 días de la semana, las 24 horas, con servicio a domicilio, emergencias 24/7 y convenios de internación.',
  url: siteUrl,
  logo: `${siteUrl}og-cecp.jpg`,
  image: `${siteUrl}og-cecp.jpg`,
  telephone: `+${TELEFONO}`,
  priceRange: '$$',
  currenciesAccepted: 'USD',
  address: {
    '@type': 'PostalAddress',
    streetAddress: DIRECCION,
    addressLocality: 'Guayaquil',
    addressRegion: 'Guayas',
    postalCode: '090505',
    addressCountry: 'EC',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: COORDENADAS.lat,
    longitude: COORDENADAS.lon,
  },
  hasMap: MAPS_SHARE,
  // Horas de APERTURA AL PÚBLICO (consultorio sin cita). La disponibilidad
  // 24/7 con cita previa, el domicilio y las emergencias NO van aquí: en
  // schema.org este campo alimenta el "Abierto/Cerrado" de Google, y declarar
  // 24 h llevaría a un paciente a presentarse en la puerta de madrugada.
  // Esa disponibilidad se declara abajo, en availableService.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: HORARIO.consultorio.diasSchema,
      opens: HORARIO.consultorio.abre,
      closes: HORARIO.consultorio.cierra,
    },
  ],
  availableService: [
    { '@type': 'MedicalProcedure', name: 'Cardiogenética y Amiloidosis Cardíaca' },
    { '@type': 'MedicalProcedure', name: 'Electrocardiograma (ECG)' },
    { '@type': 'MedicalProcedure', name: 'Holter de arritmias 24h' },
    { '@type': 'MedicalProcedure', name: 'Holter de presión (MAPA) 24h' },
    { '@type': 'MedicalProcedure', name: 'Ecocardiograma' },
    // Disponibilidad anunciada en la sección Horario de la web
    ...HORARIO.serviciosExtendidos.map((name) => ({ '@type': 'MedicalProcedure', name })),
  ],
  medicalSpecialty: ['Cardiovascular', 'Pediatric', 'Gynecologic', 'Dentistry', 'Genetics'],
  makesOffer: {
    '@type': 'Offer',
    name: MEMBRESIA.nombre,
    description: `Membresía familiar mensual de CECP: consultas con especialistas, procedimientos cardiovasculares, exámenes de laboratorio y estudios de imagen, con hasta ${MEMBRESIA.descuento}% de descuento en las especialidades para toda la familia.`,
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: MEMBRESIA.precio,
      priceCurrency: 'USD',
      referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' },
    },
    category: 'Membresía familiar',
    availability: 'https://schema.org/InStock',
    url: `${siteUrl}#membresia`,
  },
  sameAs: [REDES.tiktok, REDES.facebook, REDES.instagram],
  email: EMAIL,
};

// Médicos: generados desde src/data/especialidades.ts (una sola fuente de verdad).
// Solo entran perfiles con especialidad schema.org declarada: los profesionales
// no médicos (p. ej. licenciados) no deben marcarse como Physician.
const schemaMedicos = {
  '@context': 'https://schema.org',
  '@graph': especialidades
    .filter((e) => e.doctor !== 'Equipo CECP' && e.schemaEspecialidad)
    .map((e) => ({
      '@type': e.schemaTipo ?? 'Physician',
      name: e.doctor,
      ...(e.schemaEspecialidad ? { medicalSpecialty: e.schemaEspecialidad } : {}),
      worksFor: { '@id': `${siteUrl}#clinic` },
    })),
};
---

<Base title={TITLE} description={DESCRIPTION}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaClinica)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaMedicos)} />
  </Fragment>

  <Loader />
  <Hero />
  <Confianza />
  <Cardiogenetica />
  <Especialidades />
  <Membresia />
  <Horario />
  <Testimonios />
  <Contacto />
  <MapaUbicacion />
</Base>
